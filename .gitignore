# Raw upstream data never enters git: the generator fetches the pinned sources
# on demand and only the generated Go tables are committed. Root-scoped so that
# testdata fixtures are not silently ignored.
/*.json
/*.csv

# `go build ./cmd/d3fendgen` drops the binary here, wherever it is run from.
/d3fendgen
/cmd/d3fendgen/d3fendgen

# `go build ./cmd/kevgen` does the same for the KEV generator.
/kevgen
/cmd/kevgen/kevgen

# `make build` (or `go build ./cmd/gr4ph`) drops the lookup CLI here.
/gr4ph
/cmd/gr4ph/gr4ph

# Editor and OS droppings.
.DS_Store
*~
*.swp
